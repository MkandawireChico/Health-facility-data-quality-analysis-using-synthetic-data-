// Expanded Health Facility Data Intelligence — DAX measure library
// Apply after creating the documented star schema.
// All measures describe synthetic portfolio data.

Total Reporting Records =
COUNTROWS ( FactReporting )

Facilities Represented =
DISTINCTCOUNT ( FactReporting[Facility_ID] )

Reporting Months =
DISTINCTCOUNT ( DimDate[MonthStart] )

Reported Value Availability Rate =
VAR EligibleRows =
    FILTER (
        FactReporting,
        NOT ISBLANK ( FactReporting[Reported_Value] )
            && NOT ISBLANK ( FactReporting[Target_Value] )
            && NOT ISBLANK ( FactReporting[Data_Source] )
    )
RETURN
    DIVIDE ( COUNTROWS ( EligibleRows ), [Total Reporting Records] )

Known Timeliness Records =
COUNTROWS (
    FILTER (
        FactReporting,
        NOT ISBLANK ( FactReporting[Submission_Date] )
            && NOT ISBLANK ( FactReporting[Deadline_Date] )
    )
)

On-Time Reporting Records =
COUNTROWS (
    FILTER (
        FactReporting,
        NOT ISBLANK ( FactReporting[Submission_Date] )
            && NOT ISBLANK ( FactReporting[Deadline_Date] )
            && FactReporting[Submission_Date] <= FactReporting[Deadline_Date]
    )
)

On-Time Reporting Rate =
DIVIDE ( [On-Time Reporting Records], [Known Timeliness Records] )

Late Reporting Records =
CALCULATE (
    [Total Reporting Records],
    FactReporting[Quality_Late_Submission] = TRUE ()
)

Late Reporting Rate =
DIVIDE ( [Late Reporting Records], [Known Timeliness Records] )

Missing Reported Value Records =
CALCULATE (
    [Total Reporting Records],
    FactReporting[Quality_Missing_Reported_Value] = TRUE ()
)

Source Reconciliation Review Records =
CALCULATE (
    [Total Reporting Records],
    FactReporting[Quality_Source_Discrepancy] = TRUE ()
)

Source Reconciliation Review Rate =
DIVIDE ( [Source Reconciliation Review Records], [Total Reporting Records] )

Insufficient Source Evidence Records =
CALCULATE (
    [Total Reporting Records],
    FactReporting[Quality_Insufficient_Source_Count] = TRUE ()
)

Potential Outlier Records =
CALCULATE (
    [Total Reporting Records],
    FactReporting[Operational_Detected_Outlier] = TRUE ()
)

Records Requiring Follow-Up =
COUNTROWS (
    FILTER (
        FactReporting,
        FactReporting[Quality_Missing_Reported_Value] = TRUE ()
            || FactReporting[Quality_Source_Discrepancy] = TRUE ()
            || FactReporting[Quality_Late_Submission] = TRUE ()
            || FactReporting[Operational_Detected_Outlier] = TRUE ()
            || FactReporting[Quality_Insufficient_Source_Count] = TRUE ()
            || FactReporting[Quality_Invalid_Numeric_Count] > 0
            || FactReporting[Quality_Negative_Value_Count] > 0
            || FactReporting[Quality_Invalid_Source_Label] = TRUE ()
            || FactReporting[Quality_Missing_Submission_Date] = TRUE ()
            || FactReporting[Quality_Missing_Deadline_Date] = TRUE ()
    )
)

Distinct Follow-Up Rate =
DIVIDE ( [Records Requiring Follow-Up], [Total Reporting Records] )

Average Source Spread =
AVERAGE ( FactReporting[Quality_Source_Spread] )

Peer Anomaly Records =
CALCULATE (
    COUNTROWS ( FactPeerAnomaly ),
    FactPeerAnomaly[Statistical_Anomaly] = TRUE ()
)

Monthly Issue Rate =
DIVIDE (
    SUM ( FactMonthlyQualityTrend[detected_issue_records] ),
    SUM ( FactMonthlyQualityTrend[records] )
)

Synthetic Evaluation Macro Precision =
AVERAGE ( FactDetectorEvaluation[precision] )

Synthetic Evaluation Macro Recall =
AVERAGE ( FactDetectorEvaluation[recall] )

Synthetic Evaluation Macro F1 =
AVERAGE ( FactDetectorEvaluation[f1] )

Synthetic Evaluation False Positive Rate =
AVERAGE ( FactDetectorEvaluation[false_positive_rate] )

// Interpretation notes:
// - Issue categories overlap; follow-up counts above count each fact row once.
// - On-time rate excludes rows with missing submission/deadline dates.
// - Reported Value Availability Rate is not a clinical completeness measure.
// - Macro detector metrics describe injected synthetic defects only.
// - Do not use synthetic metrics to claim real-world detector performance.


// District and longitudinal monitoring measures
District Reporting Records =
SUM ( FactDistrictMonthlyTrend[records] )

District Detected Issue Records =
SUM ( FactDistrictMonthlyTrend[detected_issue_records] )

District Weighted Issue Rate =
DIVIDE ( [District Detected Issue Records], [District Reporting Records] )

Districts Represented =
DISTINCTCOUNT ( FactDistrictMonthlyTrend[District] )

District-Month Review Signals =
CALCULATE (
    COUNTROWS ( FactMonthlyIssueControlChart ),
    FactMonthlyIssueControlChart[Outside_Descriptive_Limits] = TRUE ()
)

Monthly Control Centre Line =
MAX ( FactMonthlyIssueControlChart[Centre_Line] )

Monthly Upper Descriptive Limit =
MAX ( FactMonthlyIssueControlChart[Upper_Control_Limit] )

Monthly Lower Descriptive Limit =
MAX ( FactMonthlyIssueControlChart[Lower_Control_Limit] )

// District rates are weighted by reporting volume. Do not average district
// percentages to calculate a combined rate. Control limits are retrospective.


// Target attainment measures (same programme-indicator grain only)
Facility Indicator Target Attainment =
DIVIDE (
    SUM ( FactFacilityIndicatorAttainment[reported_total] ),
    SUM ( FactFacilityIndicatorAttainment[target_total] )
)

Facility Indicator Combinations Below 80 Percent =
CALCULATE (
    COUNTROWS ( FactFacilityIndicatorAttainment ),
    FactFacilityIndicatorAttainment[attainment_pct] < 80
)

District Indicator Target Attainment =
DIVIDE (
    SUM ( FactDistrictIndicatorAttainment[reported_total] ),
    SUM ( FactDistrictIndicatorAttainment[target_total] )
)

Monthly Indicator Target Attainment =
DIVIDE (
    SUM ( FactMonthlyIndicatorAttainment[reported_total] ),
    SUM ( FactMonthlyIndicatorAttainment[target_total] )
)

Programme Indicator Target Attainment =
DIVIDE (
    SUM ( FactProgrammeIndicatorAttainment[reported_total] ),
    SUM ( FactProgrammeIndicatorAttainment[target_total] )
)

Target Attainment Valid Records =
SUM ( FactFacilityIndicatorAttainment[valid_attainment_records] )

// These are pooled reported-to-target ratios for comparable indicators.
// They are not population coverage measures or official service standards.


// Resource capacity scenario measures. Select one Scenario at a time when
// comparing allocations; the two resource facts remain separate.
Illustrative Resource Requirement Units =
SUM ( FactFacilityResourceCapacity[Illustrative_Requirement_Units] )

Synthetic Available Resource Units =
SUM ( FactFacilityResourceCapacity[Synthetic_Available_Units] )

Baseline Resource Gap Units =
SUM ( FactFacilityResourceCapacity[Baseline_Gap_Units] )

Scenario Allocated Resource Units =
SUM ( FactResourceAllocationScenario[Allocated_Units] )

Scenario Residual Resource Gap Units =
SUM ( FactResourceAllocationScenario[Residual_Gap_Units] )

Scenario Post-Allocation Capacity Coverage =
DIVIDE (
    SUM ( FactResourceAllocationScenario[Synthetic_Available_Units] )
        + SUM ( FactResourceAllocationScenario[Allocated_Units] ),
    SUM ( FactResourceAllocationScenario[Illustrative_Requirement_Units] )
)

// Resource units are illustrative synthetic abstractions, not staff or money.

 
// Commodity stock and replenishment measures. Keep abstract credits clearly
// labelled; they are not monetary values or MWK procurement expenditure.
Commodity Stockout Days =
SUM ( FactFacilityCommodityStock[Stockout_Days] )

Commodity Unmet Demand Units =
SUM ( FactFacilityCommodityStock[Unmet_Demand_Units] )

Commodity Stockout Facility-Item Pairs =
CALCULATE (
    COUNTROWS ( FactFacilityCommodityStock ),
    FactFacilityCommodityStock[Stockout_Flag] = TRUE ()
)

Commodity Requested Replenishment Units =
SUM ( FactCommodityReplenishmentPlan[Requested_Replenishment_Units] )

Commodity Allocated Replenishment Units =
SUM ( FactCommodityReplenishmentPlan[Allocated_Replenishment_Units] )

Commodity Unfunded Replenishment Units =
SUM ( FactCommodityReplenishmentPlan[Unfunded_Replenishment_Units] )

Commodity Allocated Budget Credits =
SUM ( FactCommodityReplenishmentPlan[Allocated_Cost_Credits] )

Commodity Average Days of Cover =
AVERAGE ( FactCommodityReplenishmentPlan[Estimated_Days_of_Cover] )


// Cold-chain, batch and expiry monitoring. All underlying observations and
// quantities are synthetic; temperature thresholds and risk bands are illustrative.
Cold Chain Temperature Excursion Days =
SUM ( FactColdChainTemperature[Excursion_Days] )

Cold Chain Facility-Months with Excursions =
CALCULATE (
    COUNTROWS ( FactColdChainTemperature ),
    FactColdChainTemperature[Temperature_Excursion_Flag] = TRUE ()
)

Cold Chain Average Temperature Coverage Pct =
AVERAGE ( FactColdChainTemperature[Temperature_Data_Coverage_Pct] )

Cold Chain Near Expiry 90 Day Units =
SUM ( FactColdChainExpiryRisk[Near_Expiry_90_Day_Units] )

Cold Chain Near Expiry 30 Day Units =
SUM ( FactColdChainExpiryRisk[Near_Expiry_30_Day_Units] )

Cold Chain Expired Units =
SUM ( FactColdChainExpiryRisk[Expired_Units] )

Cold Chain Unmet Demand Units =
SUM ( FactColdChainExpiryRisk[Unmet_Demand_Units] )

Cold Chain High Risk Facility Commodity Months =
CALCULATE (
    COUNTROWS ( FactColdChainExpiryRisk ),
    FactColdChainExpiryRisk[Risk_Band] = "High"
)

Cold Chain Average Risk Score =
AVERAGE ( FactColdChainExpiryRisk[Cold_Chain_Risk_Score] )

Cold Chain Closing Batch Stock =
SUM ( FactCommodityBatchLedger[Closing_Stock_Units] )


// Equipment asset, preventive maintenance and uptime monitoring.
// All underlying asset records and metrics are synthetic.
Equipment Asset Count =
DISTINCTCOUNT ( FactEquipmentAssetRegister[Asset_ID] )

Equipment Mean Operational Uptime Pct =
AVERAGE ( FactEquipmentAssetMonthly[Operational_Uptime_Pct] )

Equipment Mean Service Availability Pct =
AVERAGE ( FactEquipmentAssetMonthly[Service_Availability_Pct] )

Equipment Unplanned Downtime Hours =
SUM ( FactEquipmentAssetMonthly[Unplanned_Downtime_Hours] )

Equipment Planned Maintenance Downtime Hours =
SUM ( FactEquipmentAssetMonthly[Planned_Maintenance_Downtime_Hours] )

Equipment Breakdown Events =
SUM ( FactEquipmentAssetMonthly[Breakdown_Count] )

Equipment Preventive Maintenance Due =
CALCULATE (
    COUNTROWS ( FactEquipmentAssetMonthly ),
    FactEquipmentAssetMonthly[Preventive_Maintenance_Due] = TRUE ()
)

Equipment Preventive Maintenance Completed =
CALCULATE (
    COUNTROWS ( FactEquipmentAssetMonthly ),
    FactEquipmentAssetMonthly[Preventive_Maintenance_Completed] = TRUE ()
)

Equipment Preventive Maintenance Overdue =
CALCULATE (
    COUNTROWS ( FactEquipmentAssetMonthly ),
    FactEquipmentAssetMonthly[Preventive_Maintenance_Overdue] = TRUE ()
)

Equipment Preventive Maintenance Completion Pct =
DIVIDE (
    [Equipment Preventive Maintenance Completed],
    [Equipment Preventive Maintenance Due]
) * 100

Equipment Open Work Orders =
CALCULATE (
    COUNTROWS ( FactEquipmentMaintenanceWorkOrders ),
    FactEquipmentMaintenanceWorkOrders[Status] <> "Closed"
)

Equipment Maintenance Cost Credits =
SUM ( FactEquipmentAssetMonthly[Maintenance_Cost_Credits] )

Equipment High Risk Assets =
CALCULATE (
    DISTINCTCOUNT ( FactEquipmentLatestAssetRisk[Asset_ID] ),
    FactEquipmentLatestAssetRisk[Risk_Band] = "High"
)

Equipment Mean Condition Score =
AVERAGE ( FactEquipmentAssetMonthly[Condition_Score] )

Equipment Mean Risk Score =
AVERAGE ( FactEquipmentLatestAssetRisk[Equipment_Risk_Score] )
